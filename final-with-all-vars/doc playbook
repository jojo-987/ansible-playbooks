- name: Replace multiple environment tokens
  ansible.builtin.replace:
    path: "appsettings.json"
    regexp: "{{ item.token }}"
    replace: "{{ lookup('env', item.env_var) }}"
  loop:
    - { token: '__DB_STRING__', env_var: 'DB_CONNECTION_STRING' }
    - { token: '__API_KEY__', env_var: 'SERVICE_API_KEY' }


- name: Replace token using Vault variable
  hosts: all
  vars_files:
    - "vars/{{ env_name }}_secrets.yml"  # Dynamically loads dev_secrets or prod_secrets
  tasks:
    - name: Replace placeholder in appsettings.json
      ansible.builtin.replace:
        path: "/path/to/appsettings.json"
        regexp: '__DB_STRING__'
        replace: "{{ db_connection_string }}"
      no_log: true  # CRITICAL: Prevents the secret from showing in Jenkins logs

pipeline {
    agent any
    environment {
        // This injects the secret text into an environment variable
        VAULT_PASS = credentials('ANSIBLE_VAULT_PASSWORD')
    }
    stages {
        stage('Deploy') {
            steps {
                sh """
                # Create a temporary password file for Ansible
                echo \$VAULT_PASS > .vault_pass
                
                ansible-playbook deploy.yml \
                  -e "env_name=prod" \
                  --vault-password-file .vault_pass
                
                # Clean up the password file
                rm .vault_pass
                """
            }
        }
    }
}
